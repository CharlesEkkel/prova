# Written for you by `just env` from the running local stack (`pnpm exec supabase status -o env`).
# Public environment variables only: no platform-specific bindings.

# Required at build time: Vite bakes them into the app, and the build fails without them.
# The local stack's values are API_URL and ANON_KEY.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# Optional, build time: the largest Practice Track a Singer may upload, in whole MiB (default 10).
# The screens say it, and `node scripts/apply-upload-limit.mjs` (run on every deploy, with
# SUPABASE_SERVICE_ROLE_KEY set) applies the same number to the storage bucket.
# PUBLIC_UPLOAD_LIMIT_MIB=10

# Tests only, against the local stack: creates people and grants Roles. Never set this where the
# app runs.
SUPABASE_SERVICE_ROLE_KEY=
