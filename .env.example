# Public environment variables only: no platform-specific bindings.
# Fill these from `pnpm supabase status -o env` (API_URL and ANON_KEY).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# Used by the backend contract tests.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Local stack only, used by the tests to create people and grant Roles. Never set this in production.
SUPABASE_SERVICE_ROLE_KEY=
