# Read by the Supabase CLI when it starts the local stack (supabase/config.toml), not by the app.
# Copy to supabase/.env (git-ignored), fill in your Google OAuth client and restart the stack.
# See "Google sign-in" in the README. Without these the stack still starts and the tests still
# pass; only the real Google button fails.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
