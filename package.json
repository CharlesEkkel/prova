{
  "name": "prova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "postinstall": "svelte-kit sync && node scripts/copy-pdfjs-wasm.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.json",
    "test:resolver": "vitest run --project resolver",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "test": "pnpm test:resolver && pnpm test:contract && pnpm test:e2e",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "bundle-size": "node scripts/report-bundle-size.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,svelte}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.52.0",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "bits-ui": "^2.19.5",
    "effect": "^4.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "supabase": "^2.119.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
