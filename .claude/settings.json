{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Bash(cat **/.env)",
      "Bash(cat .env)",
      "Bash(cat **/.env.local)",
      "Bash(cat .env.local)",
      "Bash(grep * .env)",
      "Bash(grep * **/.env)",
      "Bash(source .env)",
      "Bash(source **/.env)"
    ]
  }
}
